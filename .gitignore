# Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# run artifacts: keep metrics, drop the (large) network weights except the delivered ones
runs/**/*.npz
runs/**/*.json
runs/**/*.pth
deliverables/*.pth
runs/**/*.tmp.npz
*.log

# generated
notebooks/*_output.ipynb
report/figures/*.png
report/tables/*.md
!report/figures/.gitkeep
!report/tables/.gitkeep

# archive built by scripts/package.py
*.zip

# per-game intermediates: video.mp4 is the deliverable
video_pong.mp4
video_treasure_*.mp4
